---
import { Icon } from "astro-icon/components";
import * as about from "../pages/about/about.md";

const socials = [
  { icon: "carbon:email",        url: "mailto:gargarnav10@gmail.com",         label: "Email" },
  { icon: "carbon:logo-github",  url: "https://github.com/ArnavGarg10",        label: "GitHub" },
  { icon: "carbon:logo-discord", url: "https://discord.com/",                  label: "Discord" },
  { icon: "carbon:logo-linkedin",url: "https://linkedin.com/in/arnav-garg-15b114415/", label: "LinkedIn" },
];
---

<header class="mx-auto pt-6 pb-2">
  <article class="flex flex-col items-center gap-3 w-full max-w-2xl">

    <div class="flex-shrink-0 w-20 md:w-24 rounded-full shadow-sm overflow-hidden">
      <img alt="avatar" src="/profile.png" class="grayscale-[50] hover:grayscale-0" />
    </div>

    <div class="flex flex-col items-center gap-1">
      <h1 class="text-3xl font-extrabold tracking-tight text-center">
        {about.frontmatter.name}
      </h1>
      <p class="text-xs text-secondary tracking-wide">
        pronouns: {about.frontmatter.pronouns}
      </p>
      <h2 class="text-lg text-secondary">{about.frontmatter.designation}</h2>

      <div class="flex items-center gap-1 mt-0.5">
        <Icon name="carbon:location" class="w-4 h-4" />
        <p class="text-sm text-secondary">{about.frontmatter.location}</p>
      </div>

      <div class="flex items-center gap-3 mt-2">
        {socials.map((s) => (
          <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label}
             class="opacity-70 hover:opacity-100 transition-opacity">
            <Icon name={s.icon} class="w-5 h-5" />
          </a>
        ))}
      </div>
    </div>

  </article>
</header>
